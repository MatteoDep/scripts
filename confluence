#!/bin/bash
set -euo pipefail

# Confluence CLI: publish markdown to, or download pages from, Confluence.
#
# Credentials (orgname, username, API key) are asked once and cached in
#   $CONFIG_FILE  (chmod 600, outside the notes vault). Shared by both commands.
#
# Usage:
#   ./confluence publish  [options] <markdown_file>
#   ./confluence download [options] [url|spacekey] [output_dir]
#   ./confluence configure            Re-enter and re-cache credentials.
#
# publish options:
#   -s, --space KEY        Space key (skip interactive picker).
#   -a, --ancestor TITLE   Ancestor page title (skip interactive picker).
#       --no-ancestor      Publish at space root.
#
# download options:
#       --descendants      Include the page's descendants.
#       --space            Download a whole space (pick interactively if no arg).
#   (default: a single page; pass its URL)
#
# common options:
#       --reconfigure      Re-enter credentials before running.
#   -h, --help             Show this help.
#
# Examples:
#   ./confluence publish notes.md
#   ./confluence publish -s SPACE -a "Parent Page" notes.md
#   ./confluence download https://mycompany.atlassian.net/wiki/spaces/SPACE/pages/123/Title
#   ./confluence download --descendants <url> ./out
#   ./confluence download --space SPACE ./out

# shared Atlassian auth + API helpers (credentials, load_config, api calls)
# shellcheck source=/dev/null
. "$(dirname "$(readlink -f "$0")")/atlassian"

die() { atlassian_die "$@"; }
need() { atlassian_need "$@"; }
usage() { sed -n '4,33p' "$0" | sed 's/^# \?//'; }

load_config() { atlassian_load_config; }

# GET against the Confluence REST API; $1 is a path like /space
api() { local path="$1"; shift; atlassian_api confluence "$path" -G "$@"; }

# ---- interactive pickers (live instance) ----
pick_space() {  # echoes selected space key
    echo "Fetching spaces..." >&2
    local spaces
    spaces="$(api /space --data-urlencode "type=global" --data-urlencode "limit=250" \
        | jq -r '.results[] | "\(.key)\t\(.name)"' | sort -t$'\t' -k2)" \
        || die "failed to fetch spaces (check credentials / org subdomain)"
    [ -n "$spaces" ] || die "no spaces returned"
    printf '%s\n' "$spaces" | fzf --with-nth=2.. --delimiter='\t' \
        --prompt="Space> " --height=40% --reverse | cut -f1
}

pick_ancestor() {  # $1=space key; echoes title or empty for root
    echo "Fetching pages in $1..." >&2
    local pages choice
    pages="$(api /content \
        --data-urlencode "spaceKey=$1" \
        --data-urlencode "type=page" \
        --data-urlencode "limit=500" \
        | jq -r '.results[].title' | sort)" \
        || die "failed to fetch pages for space $1"
    choice="$(printf '[none] (space root)\n%s\n' "$pages" \
        | fzf --prompt="Ancestor> " --height=40% --reverse)"
    [ -n "$choice" ] || die "no ancestor selected"
    [ "$choice" = "[none] (space root)" ] || printf '%s' "$choice"
}

# ---- publish ----
cmd_publish() {
    local space="" ancestor="" ancestor_set=0 md_file=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--space)    space="${2:-}"; shift 2 ;;
            -a|--ancestor) ancestor="${2:-}"; ancestor_set=1; shift 2 ;;
            --no-ancestor) ancestor=""; ancestor_set=1; shift ;;
            -*)            die "unknown publish option: $1" ;;
            *)             [ -z "$md_file" ] || die "only one markdown file allowed"; md_file="$1"; shift ;;
        esac
    done
    [ -n "$md_file" ] || die "no markdown file given"
    [ -f "$md_file" ] || die "file not found: $md_file"
    need md-to-conf curl jq fzf
    load_config

    [ -n "$space" ] || space="$(pick_space)"
    [ -n "$space" ] || die "no space selected"
    echo "Space: $space" >&2

    [ "$ancestor_set" -eq 1 ] || ancestor="$(pick_ancestor "$space")"
    [ -n "$ancestor" ] && echo "Ancestor: $ancestor" >&2 || echo "Ancestor: (space root)" >&2

    echo "Publishing '$md_file' to space '$space'..." >&2
    local args=( "$md_file" "$space"
        --username "$ATLASSIAN_USERNAME"
        --apikey   "$ATLASSIAN_API_KEY"
        --orgname  "$ATLASSIAN_ORGNAME" )
    [ -n "$ancestor" ] && args+=( --ancestor "$ancestor" )
    md-to-conf "${args[@]}"
    echo "Done." >&2
}

# ---- download ----
cmd_download() {
    local mode="page" arg="" out_dir=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --descendants) mode="page-with-descendants"; shift ;;
            --space)       mode="space"; shift ;;
            -*)            die "unknown download option: $1" ;;
            *)             if [ -z "$arg" ]; then arg="$1"; else out_dir="$1"; fi; shift ;;
        esac
    done
    out_dir="${out_dir:-./confluence_export}"
    need cme curl jq python3
    load_config

    local url="$arg"
    if [ "$mode" = "space" ]; then
        # accept a full space URL, a bare space key, or nothing (pick one)
        case "$arg" in
            http*) url="$arg" ;;
            "")    url="$BASE_URL/wiki/spaces/$(pick_space)" ;;
            *)     url="$BASE_URL/wiki/spaces/$arg" ;;
        esac
    fi
    [ -n "$url" ] || die "download needs a page URL (or use --space)"

    mkdir -p "$out_dir"

    # cme stores auth keyed by instance URL in a JSON config file; patch it directly.
    local cme_cfg
    cme_cfg="$(cme config path)"
    mkdir -p "$(dirname "$cme_cfg")"
    [ -f "$cme_cfg" ] || echo '{}' > "$cme_cfg"
    python3 - "$cme_cfg" "$BASE_URL" "$ATLASSIAN_USERNAME" "$ATLASSIAN_API_KEY" <<'PY'
import json, sys
path, base_url, user, token = sys.argv[1:5]
with open(path) as f:
    cfg = json.load(f)
cfg.setdefault("auth", {}).setdefault("confluence", {})[base_url] = {
    "username": user, "api_token": token, "pat": "", "cloud_id": ""
}
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
PY

    export CME_EXPORT__OUTPUT_PATH="$out_dir"
    echo "Downloading ($mode) '$url' to '$out_dir'..." >&2
    cme "$mode" "$url"
    echo "Done." >&2
}

# ---- dispatch ----
RECONFIGURE=0
sub=""
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --reconfigure) RECONFIGURE=1; shift ;;
        -h|--help)     usage; exit 0 ;;
        publish|download|configure)
            [ -z "$sub" ] || args+=( "$1" ); [ -n "$sub" ] || sub="$1"; shift ;;
        *)             args+=( "$1" ); shift ;;
    esac
done

case "$sub" in
    publish)   cmd_publish "${args[@]}" ;;
    download)  cmd_download "${args[@]}" ;;
    configure) need curl jq; atlassian_prompt_config ;;
    "")        usage; exit 1 ;;
    *)         die "unknown command: $sub" ;;
esac
