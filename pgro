#!/usr/bin/env bash
# Read-only Postgres queries by service name (from ~/.pg_service.conf), never seeing a password.
# Meant for AI agents: on read-only services it refuses anything that is not a plain read,
# on top of the read-only session the service already sets up; services marked read-write
# by the dadbod sync allow any SQL. This is a safety catch, not a security boundary: a
# determined client can bypass it. Passwords come from the service's passfile.
# Services with a kubectl tunnel (`tunnel:` in connections.yaml) get it started or checked by
# dbtunnel first.

set -euo pipefail

usage() {
    name=$(basename "$0")
    cat <<EOF
Usage: $name [-d dbname] <service> [sql]     (sql is read from stdin when not given)
       $name -l                              list services

Read-only connections allow SELECT, WITH, EXPLAIN, SHOW, VALUES, TABLE statements.
Read-write connections ("rw: true" in connections.yaml) allow any SQL.
psql meta-commands are limited to \\d..., \\l, \\x, \\conninfo everywhere.
For changes on read-only connections, write the SQL and let a human run it.
Connections with a tunnel get their kubectl port-forward started by dbtunnel (see dbtunnel -h);
an expired AWS SSO session opens the login page in the browser.

Exit codes: 2 usage, 4 refused by pgro, 5 tunnel or login failure; otherwise psql's.
EOF
}

service_file=${PGSERVICEFILE:-$HOME/.pg_service.conf}

# Only services generated by the dadbod sync: those are read-only on the server side,
# except the ones marked "# dadbod: read-write" (`rw: true` in connections.yaml).
# Prints "name mode tunnel" per service, mode being ro or rw, tunnel yes or no
# ("# dadbod: tunnel ..." marker, read by dbtunnel). Markers come in any order before a section.
services() {
    awk '/^# BEGIN dadbod/ { inside = 1; next } /^# END dadbod$/ { inside = 0 }
         !inside { next }
         $0 == "# dadbod: read-write" { rw = 1; next }
         /^# dadbod: tunnel / { tun = 1; next }
         /^\[.*\]$/ { print substr($0, 2, length($0) - 2), (rw ? "rw" : "ro"), (tun ? "yes" : "no"); rw = 0; tun = 0 }' \
        "$service_file" 2>/dev/null
}

dbname=
while getopts 'd:lh' opt; do
    case $opt in
        d) dbname=$OPTARG ;;
        l) services | awk '{ print $1 ($2 == "rw" ? " (read-write)" : "") ($3 == "yes" ? " (tunnel)" : "") }'; exit 0 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] && [ $# -le 2 ] || { usage >&2; exit 2; }
service=$1
if [ $# -eq 2 ]; then sql=$2; else sql=$(cat); fi

# exit codes: 2 usage, 4 refused by pgro, 5 tunnel/login failure (dbtunnel);
# otherwise psql's (1 fatal, 2 connection, 3 SQL error)
die() { printf 'pgro: %s\n' "$*" >&2; exit 4; }

[[ $service =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid service name"
[[ -z $dbname || $dbname =~ ^[A-Za-z0-9_.$-]+$ ]] || die "invalid database name"
read -r mode tunnel < <(services | awk -v s="$service" '$1 == s { print $2, $3 }') || true
[ -n "${mode:-}" ] || die "unknown service '$service' (pgro -l lists them)"

# psql runs backticks in meta-command arguments as shell commands
[[ $sql == *'`'* ]] && die "backticks are not allowed"

# Strip comments (they could hide the start of a statement), then inspect the rest
clean=$(printf '%s' "$sql" | perl -0pe 's{/\*.*?\*/}{ }gs; s/--[^\n]*//g')

# psql meta-commands, on every connection: only harmless ones
# (blocks \! \c \i \o \gexec \set \copy ..., which act on this machine or the connection)
while read -r meta; do
    [[ $meta =~ ^\\(d[A-Za-z]*\+?|l\+?|x|conninfo)$ ]] || die "meta-command '$meta' not allowed"
done < <(printf '%s' "$clean" | grep -oE '\\[A-Za-z!?+]+' || true)

# Read-write connections stop here: any SQL goes
if [ "$mode" = ro ]; then
    shopt -s nocasematch
    # Switching read-only off, and server-side effects a read-only transaction does not stop
    # (mostly superuser). Checked on the raw SQL: comment stripping is not string-aware.
    blocked='(read[[:space:]]+write|transaction_read_only|set_config|pg_terminate_backend|pg_cancel_backend|pg_reload_conf|pg_rotate_logfile|pg_promote|pg_switch_wal|pg_create_restore_point|replication_slot|pg_stat_reset|pg_file_|pg_read_file|pg_read_binary_file|pg_ls_dir|lo_export|lo_import|dblink|pg_advisory|pg_authid|pg_shadow|rolpassword)'
    [[ $sql =~ $blocked ]] && die "refused: '${BASH_REMATCH[1]}' is not allowed (read-only connection)"

    # Every statement must start with a read-only keyword
    without_meta=$(printf '%s' "$clean" | sed -E 's/\\[A-Za-z!?+]+[^;]*//g')
    IFS=';' read -r -d '' -a statements < <(printf '%s\0' "$without_meta")
    for stmt in "${statements[@]}"; do
        first=$(printf '%s' "$stmt" | tr -s '[:space:](' ' ' | sed 's/^ *//' | cut -d' ' -f1)
        [ -z "$first" ] && continue
        [[ $first =~ ^(select|with|explain|show|values|table)$ ]] ||
            die "refused: '$first' statements are not allowed (read-only connection)"
    done
    shopt -u nocasematch
fi

# Start the tunnel, or check that the running one reaches the database. Never retried once
# the query runs: a connection dropped mid-script must not run the statements twice.
if [ "$tunnel" = yes ]; then
    "$(dirname "$(readlink -f "$0")")/dbtunnel" up "$service" || exit 5
fi

conninfo="service=$service"
[ -n "$dbname" ] && conninfo="$conninfo dbname=$dbname"

# Only the service decides how to connect
unset PGHOST PGHOSTADDR PGPORT PGUSER PGPASSWORD PGPASSFILE PGOPTIONS PGSERVICE PGDATABASE
export PGCONNECT_TIMEOUT=${PGCONNECT_TIMEOUT:-10}
printf '%s\n' "$sql" | exec psql -w -X -q -v ON_ERROR_STOP=1 -P pager=off -d "$conninfo"
