#!/bin/sh

usage(){
    echo "Usage: dotctl add|remove file1 file2 ..."
}

add(){
	if [ ! -e "$src" ] && [ ! -L "$src" ]; then
		echo "Skipping $i: no such file" >&2
		status=1
		return
	fi
	# Files without world-read (e.g. chmod 600/640) usually hold secrets: keep them out.
	private=$($sudocmd find "$src" -type f ! -perm -o=r) || {
		echo "Skipping $i: could not check permissions" >&2
		status=1
		return
	}
	if [ -n "$private" ]; then
		echo "Skipping $i: not world-readable, may hold secrets:" >&2
		printf '%s\n' "$private" | sed 's/^/  /' >&2
		status=1
		return
	fi
	mkdir -p "$(dirname "$dst")" &&
		$sudocmd mv "$src" "$dst" &&
		$sudocmd ln -s "$dst" "$src" || status=1
}

remove(){
	[ -n "$i" ] && {
		if [ -e "$dst" ]; then
			$sudocmd trash-put "$src"
			$sudocmd mv "$dst" "$src"
		else
			echo "Skipping $i as is not synched!"
		fi
	}
}

status=0
case "$1" in
    add|remove)
		command=$1
        shift
		for i in "$@"; do
			dotfiles_dir="${DOTFILES_DIR:-"$HOME/.dotfiles"}"
			src=$(realpath -s "$i")
			if echo "$src" | grep -q "$HOME"; then
				dst="$dotfiles_dir/home/${src#"$HOME/"}"
				sudocmd=
			else
				dst="$dotfiles_dir/root$src"
				sudocmd=sudo
			fi
			echo "$i"
			$command "$i"
		done
		exit $status
        ;;
	-h|--help|help)
		usage
		exit
		;;
    *)
        [ -z "$1" ] && echo "Please specify command."
        usage
		exit 1
        ;;
esac
